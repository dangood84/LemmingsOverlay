procedure Plot(Pixels: PByte; Width, Height, X, Y: Integer; R, G, B: Byte);
var
  P: PByte;
begin
  if (X < 0) or (Y < 0) or (X >= Width) or (Y >= Height) then
    Exit;
  P := Pixels + (Y * Width + X) * 4;
  P[0] := R;
  P[1] := G;
  P[2] := B;
  P[3] := 255;
end;

procedure DrawText(Pixels: PByte; Width, Height: Integer; X, Y: Integer;
  const Text: string; R, G, B: Byte; Scale: Integer);
var
  I, Row, Col, SX, SY, PX, PY, Code: Integer;
  Glyph: TGlyph;
begin
  if Scale < 1 then
    Scale := 1;
  for I := 1 to Length(Text) do
  begin
    Code := Ord(Text[I]);
    if (Code < 32) or (Code > 126) then
      Code := 63;
    Glyph := Font8x8[Code];
    for Row := 0 to 7 do
      for Col := 0 to 7 do
        { font8x8 stores the leftmost pixel in bit 0, not the MSB. }
        if (Glyph[Row] and (1 shl Col)) <> 0 then
          for SY := 0 to Scale - 1 do
            for SX := 0 to Scale - 1 do
            begin
              PX := X + (I - 1) * 8 * Scale + Col * Scale + SX;
              PY := Y + Row * Scale + SY;
              Plot(Pixels, Width, Height, PX, PY, R, G, B);
            end;
  end;
end;

function TextWidth(const Text: string; Scale: Integer): Integer;
begin
  if Scale < 1 then
    Scale := 1;
  Result := Length(Text) * 8 * Scale;
end;

function TextHeight(Scale: Integer): Integer;
begin
  if Scale < 1 then
    Scale := 1;
  Result := 8 * Scale;
end;

end.
